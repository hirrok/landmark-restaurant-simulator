---
import EmberLayout from '../layouts/EmberLayout.astro';

const base = import.meta.env.BASE_URL;
const FORMSPREE_ID = "TODO_FORMSPREE_ID";
---

<EmberLayout
  title="Contact — The Landmark Restaurant | Lucena City, Quezon"
  description="Contact The Landmark Restaurant in Lucena City. Reserve a table, inquire about private events, or ask us anything. Call, message, or fill out the form."
  canonical="https://hirrok.github.io/landmark-restaurant-simulator/contact/"
>

  <!-- HEADER -->
  <section style="background:#1A1008; padding:4rem max(1.5rem,5vw) 3rem;">
    <div class="container">
      <p style="font-family:'DM Mono',monospace; font-size:0.7rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--amber); margin-bottom:0.75rem; display:flex; align-items:center; gap:0.75rem;">
        <span style="width:1.5rem; height:1px; background:var(--amber); display:inline-block;"></span>
        Get in Touch
      </p>
      <h1 style="font-family:'Playfair Display',serif; font-size:clamp(2rem,5vw,3.5rem); color:#FAF6F0;">
        We'd love to hear from you.
      </h1>
    </div>
  </section>


  <!-- CONTACT BODY -->
  <section class="section" style="background:var(--surface);">
    <div class="container">
      <div style="display:grid; grid-template-columns:1fr 380px; gap:4rem; align-items:start;">

        <!-- FORMS -->
        <div>
          <!-- Quick contact form -->
          <h2 style="font-family:'Playfair Display',serif; font-size:1.5rem; color:var(--warm); margin-bottom:0.5rem;">Send us a message</h2>
          <p style="font-size:0.9rem; color:var(--dim); margin-bottom:2rem;">General inquiries, table reservations, private events — whatever's on your mind.</p>

          <form
            action={`https://formspree.io/f/${FORMSPREE_ID}`}
            method="POST"
            style="display:flex; flex-direction:column; gap:1.25rem; margin-bottom:3rem;"
          >
            <input type="hidden" name="_subject" value="New Message — The Landmark Restaurant" />

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
              <div class="field-group">
                <label class="field-label">Your Name *</label>
                <input type="text" name="name" required placeholder="Juan dela Cruz" class="field-input" />
              </div>
              <div class="field-group">
                <label class="field-label">Contact Number *</label>
                <input type="tel" name="phone" required placeholder="+63 9XX XXX XXXX" class="field-input" />
              </div>
            </div>

            <div class="field-group">
              <label class="field-label">Inquiry Type</label>
              <select name="type" class="field-input">
                <option value="General">General Inquiry</option>
                <option value="Reservation">Table Reservation</option>
                <option value="Private Event">Private Event / Function</option>
                <option value="Catering">Catering Inquiry</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="field-group">
              <label class="field-label">Your Message *</label>
              <textarea name="message" required rows="4" placeholder="Tell us what you need..." class="field-input" style="resize:vertical;"></textarea>
            </div>

            <button type="submit" class="btn-primary" style="align-self:flex-start; padding:0.875rem 2rem;">
              Send Message
            </button>
          </form>

          <!-- DIVIDER -->
          <div style="border-top:1px solid var(--border); padding-top:2.5rem;">
            <h3 style="font-family:'Playfair Display',serif; font-size:1.2rem; color:var(--warm); margin-bottom:0.5rem;">Planning a private event?</h3>
            <p style="font-size:0.9rem; color:var(--dim); margin-bottom:1.5rem;">
              For functions, birthdays, corporate events, and catering — give us a few more details
              so we can prepare the right proposal for you.
            </p>
            <a href={`${base}reservations/`} class="btn-outline">Reserve for an Event →</a>
          </div>
        </div>

        <!-- INFO SIDEBAR -->
        <div style="position:sticky; top:calc(var(--nav-h) + 2rem); display:flex; flex-direction:column; gap:1rem;">

          <!-- Address & Hours -->
          <div style="background:var(--raised); border:1px solid var(--border); border-radius:4px; padding:1.5rem;">
            <p style="font-family:'DM Mono',monospace; font-size:0.65rem; letter-spacing:0.15em; text-transform:uppercase; color:var(--amber); margin-bottom:1rem;">Location & Hours</p>

            <div style="margin-bottom:1.25rem;">
              <p style="font-size:0.875rem; color:var(--ink); font-weight:700; margin-bottom:0.2rem;">Downtown Lucena City</p>
              <p style="font-size:0.875rem; color:var(--mid);">Quezon Province, Philippines</p>
            </div>

            {[
              { days:"Tuesday–Friday", hours:"11:00 AM – 10:00 PM" },
              { days:"Saturday–Sunday", hours:"10:00 AM – 11:00 PM" },
              { days:"Monday",          hours:"Closed" },
            ].map(h => (
              <div style="display:flex; justify-content:space-between; padding:0.4rem 0; border-bottom:1px solid var(--border);">
                <span style="font-size:0.825rem; color:var(--mid);">{h.days}</span>
                <span style="font-size:0.825rem; color:var(--ink);">{h.hours}</span>
              </div>
            ))}
          </div>

          <!-- Contact channels -->
          <div style="background:var(--raised); border:1px solid var(--border); border-radius:4px; padding:1.5rem;">
            <p style="font-family:'DM Mono',monospace; font-size:0.65rem; letter-spacing:0.15em; text-transform:uppercase; color:var(--amber); margin-bottom:1rem;">Contact Channels</p>
            <div style="display:flex; flex-direction:column; gap:0.75rem;">
              {[
                { label:"Phone",     value:"TODO — Insert number",   icon:"📞" },
                { label:"Messenger", value:"Message us on Facebook", icon:"💬" },
                { label:"WhatsApp",  value:"Message us on WhatsApp", icon:"📱" },
              ].map(c => (
                <div style="display:flex; align-items:center; gap:0.75rem;">
                  <span style="font-size:1rem; flex-shrink:0;">{c.icon}</span>
                  <div>
                    <p style="font-family:'DM Mono',monospace; font-size:0.6rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--dim);">{c.label}</p>
                    <p style="font-size:0.875rem; color:var(--ink);">{c.value}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Map placeholder -->
          <div style="
            background:linear-gradient(135deg, #2C1810 0%, #1A1008 100%);
            border-radius:4px;
            height:180px;
            display:flex; align-items:center; justify-content:center;
            border:1px solid rgba(194,122,43,0.2);
          ">
            <div style="text-align:center;">
              <p style="font-size:1.5rem; margin-bottom:0.5rem;">📍</p>
              <p style="font-family:'DM Mono',monospace; font-size:0.65rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--amber);">Map Embed</p>
              <p style="font-size:0.75rem; color:rgba(250,246,240,0.4); margin-top:0.25rem;">Google Maps embed added at production</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</EmberLayout>

<style>
  .field-group { display:flex; flex-direction:column; gap:0.4rem; }
  .field-label {
    font-family: 'DM Mono', monospace;
    font-size:   0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mid);
  }
  .field-input {
    background:   var(--raised);
    border:       1px solid var(--border);
    border-radius:3px;
    padding:      0.75rem 0.875rem;
    font-size:    0.9rem;
    font-family:  'Lato', sans-serif;
    color:        var(--ink);
    outline:      none;
    transition:   border-color 0.2s;
    width:        100%;
  }
  .field-input:focus { border-color: var(--amber); }
  .field-input::placeholder { color: var(--muted); }
  @media (max-width: 900px) {
    .container > div[style*="grid-template-columns:1fr 380px"] {
      grid-template-columns: 1fr !important;
    }
  }
  @media (max-width: 640px) {
    form div[style*="grid-template-columns:1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
